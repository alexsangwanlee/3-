# 보통은 제어판(설정 → 업비트 API 키)에서 저장하면 이 파일을 바탕으로 .env 가 만들어집니다.
# 직접 쓰려면: cp .env.example .env  (Windows: copy .env.example .env)
# .env 는 git에 올라가지 않습니다(.gitignore). 절대 다른 사람과 공유하지 마세요.

# 업비트 > 마이페이지 > Open API 관리
# 권한: 자산조회 / 주문조회 / 주문하기만 켜고, 출금은 반드시 끄세요. 봇을 돌릴 PC·서버의 공인 IP를 등록하세요.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# (선택) 텔레그램 알림: @BotFather 로 봇을 만들어 토큰을 받고, 봇에게 말을 건 뒤
# https://api.telegram.org/bot<토큰>/getUpdates 에서 chat id 를 확인하세요.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) AI 주간 검토: Claude(console.anthropic.com) 또는 GPT(platform.openai.com) 키 하나. 둘 다 있으면 Claude.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
